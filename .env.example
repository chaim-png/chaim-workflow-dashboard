# Supabase project "chaim-workflow". Both values are public (browser-safe) keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google OAuth client (Gmail + Calendar, read-only). Server-only secrets: set them in Vercel, never commit them.
# Authorised redirect URI: https://<your-domain>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
